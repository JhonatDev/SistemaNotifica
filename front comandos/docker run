
# criar imagens docker do frontend
cd /opt/frontend-notifica
docker build -t frontend-notifica -f Dockerfile-notifica .

# remover container antigo, se existir e criar novo container
docker rm -f frontend-notifica 2>/dev/null || true
docker run -d --name frontend-notifica \
  --restart unless-stopped \
  -p 8080:80 \
  -v /opt/frontend-notifica/notifica/browser:/opt/frontend-notifica/notifica/browser \
  -v /opt/frontend-notifica/default-notifica.conf:/etc/nginx/http.d/default.conf \
  -v /opt/frontend-notifica/logs:/var/log/nginx \
  -v /etc/localtime:/etc/localtime:ro \
  -v /etc/timezone:/etc/timezone:ro \
  frontend-notifica



# criar imagens docker do frontend
cd /opt/frontend-unifit
docker build -t frontend-unifit -f Dockerfile-unifit .

# remover container antigo, se existir e criar novo container
docker rm -f frontend-unifit 2>/dev/null || true
docker run -d --name frontend-unifit \
  --restart unless-stopped \
  -p 8081:80 \
  -v /opt/frontend-unifit/unifit/browser:/opt/frontend-unifit/unifit/browser \
  -v /opt/frontend-unifit/default-unifit.conf:/etc/nginx/http.d/default.conf \
  -v /opt/frontend-unifit/logs:/var/log/nginx \
  -v /etc/localtime:/etc/localtime:ro \
  -v /etc/timezone:/etc/timezone:ro \
  frontend-unifit

# ve se esta rodando
docker ps



# entrar no container frontend-notifica
docker exec -it frontend-notifica sh

# entrar no container frontend-unifit
docker exec -it frontend-unifit sh
